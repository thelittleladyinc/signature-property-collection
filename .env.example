# Settings this site's code reads -- NAMES ONLY. Never put a real value in this file
# or in any committed file. Real values live in Netlify (Site configuration ->
# Environment variables) or, for the scheduled jobs, in GitHub repository secrets.
# For a local run, copy this to .env (git ignores it).
#
# Generated 2026-10-13 from the names the code actually reads: netlify/functions,
# build/build.py, build/tools, scripts/netlify-build.sh and .github/workflows.
# Unset means the code's default, which for every switch is OFF. Netlify's own
# URL and DEPLOY_PRIME_URL are read too, but Netlify sets those itself.

# ---- Website leads (netlify/functions/submission-created.js, lofty-queue-drain.js) ----
# Lofty API key: every website lead goes into Lofty with it; also her Lofty listing refresh and /status.
LOFTY_API_KEY=
# "off" pauses the failed-lead retry queue (scheduled drain and the drain inside the sync) without removing the Lofty key.
LOFTY_QUEUE_DRAIN=
# Exactly "on": email Christine once about a website lead still not in Lofty after LEAD_STUCK_ALERT_MINUTES
# (default 60), and once when it goes through (lib/_lead-stuck.js; same hub path as the lead alert). Unset = off.
LEAD_STUCK_ALERT=
# Minutes a queued lead may wait before that email (a whole number, 5 to 10080; unset = 60).
LEAD_STUCK_ALERT_MINUTES=
# Seller Intelligence hub address: the instant lead-alert email to Christine (and any area alert) is sent only through it.
HUB_API_URL=
# Hub key for that address (header x-hub-key); unset = no alert email.
HUB_API_KEY=
# Build E (lib/_hub-intake.js): exactly "on" sends the value forms (free-home-valuation, sellers-page-inquiry, the homepage "value" choice) to the hub, which drafts a value review for Christine. Unset = off.
WEBSITE_TO_HUB_INTAKE=
# The hub key for that, sent as x-hub-key to HUB_API_URL: it can only write intake (not the HUB_API_KEY above).
HUB_INTAKE_KEY=
# Build E (lib/_form-plans.js): exactly "on" makes the homepage "value" choice wait for the Lofty tag "Value Review Sent" (the HV plan) instead of starting S2. This site's free-home-valuation keeps the luxury plan. Unset = off.
VALUE_REVIEW_PLAN=
# Build E (lib/_home-updates.js): exactly "on" opens the "What have you updated?" form a value review links to; answers go to the hub with HUB_INTAKE_KEY (needs hub scope valuereview:updates). Unset = off.
VALUE_REVIEW_UPDATES_FORM=
# No longer used for sending; /site-health only says to remove it if it is still set.
RESEND_API_KEY=
# Who gets the lead alert (comma-separated); unset = Christine's own inbox.
LEAD_ALERT_TO=
# Sender for the lead alert (and the paused area alerts), only if the hub allows it; unset = the hub's own sender.
LEAD_ALERT_FROM=
# Postal line for the paused map area-alert emails (area-alerts-run.js); unset = no postal line.
ALERT_MAILING_ADDRESS=
# Who approved automatic area-alert emails (area-alerts-run.js); unset = held, nothing is sent. Christine's decision.
AREA_ALERTS_APPROVED_BY=
# Key a hand-started area-alerts-run needs in its x-area-alerts-key header (16+ characters); unset = nobody can start a run.
AREA_ALERTS_RUN_KEY=

# ---- Listings and maps ----
# Netlify Blobs site id for this project's store (listings, queue, usage log); also a GitHub secret for town-market.yml.
BLOBS_SITE_ID=
# Netlify personal access token for that store; also a GitHub secret for town-market.yml.
BLOBS_TOKEN=
# "on" shows stored listings; anything else (or unset) keeps listing display off.
IDX_DISPLAY=
# Where searches go instead (her Lofty site's /listing page); unset = the address in lib/_idx-display.js.
IDX_SEARCH_URL=
# Comma-separated counties a search naming no town covers; unset = Larimer and Weld.
HOME_SEARCH_COUNTIES=
# "lofty" (default) or "mlsgrid": where listings come from.
LISTINGS_SOURCE=
# Surname that marks her own listings; unset = gwinnup.
LISTING_AGENT_SURNAME=
# Comma-separated counties to keep when storing listings; unset = no filter.
OPERATING_COUNTIES=
# Google Maps key (Geocoding, Places, Distance Matrix); also a GitHub secret for geocode-towns.yml.
GOOGLE_MAPS_API_KEY=
# Public Mapbox token (must start "pk.") for the explore map.
MAPBOX_PUBLIC_TOKEN=
# Key for Listing Engine's recent-activity feed (unset = the strip stays empty).
LISTING_FEED_KEY=
# Listing Engine API address for that feed; unset = the default in recent-activity.js.
LISTING_ENGINE_URL=
# "on" shows the recent-activity strip while listings come from Lofty; unset = hidden.
RECENT_ACTIVITY_DISPLAY=

# ---- MLS Grid (the market-data crawl behind the town figures) ----
# MLS Grid token: the market-data crawl in the 30-minute sync (and the MLS Grid listing path if LISTINGS_SOURCE=mlsgrid).
MLSGRID_API_TOKEN=
# "off" stops that market-data crawl while keeping the token.
MLSGRID_MARKET_DATA=
# Exactly "hub" reads that crawl and the on-market check from the Seller Intelligence hub (HUB_API_URL + HUB_API_KEY), never MLS Grid; unset = MLS Grid (docs/mls-via-hub.md).
MLS_SOURCE=
# GitHub repository VARIABLE for town-market.yml (not a Netlify setting): "hub" takes the town figures from the hub's GET /v1/market/towns (HUB_API_URL variable + HUB_API_KEY secret, scope market:read); unset = computed from the Blobs copy.
TOWN_STATS_SOURCE=
# Town figures tool only: the hub key when HUB_API_KEY is not set (the main site's name for it). Leave unset here.
HUB_APP_KEY=
# "true" (or 1/yes/on) is the MLS Grid kill switch: every MLS Grid call stops.
MLS_DISABLED=
# MLS Grid quota guard: share of each ceiling to stop at; unset = 0.5 (kept between 0.05 and 0.95).
MLS_QUOTA_SAFETY_FRACTION=
# MLS Grid hourly request ceiling; may only lower the published limit.
MLS_QUOTA_HOURLY_REQUESTS=
# MLS Grid hourly download ceiling in MB; may only lower the published limit.
MLS_QUOTA_HOURLY_MB=
# MLS Grid daily request ceiling; may only lower the published limit.
MLS_QUOTA_DAILY_REQUESTS=
# MLS Grid daily download ceiling in MB; may only lower the published limit.
MLS_QUOTA_DAILY_MB=
# Cloudinary as one cloudinary:// URL (or the three parts below), for re-hosting MLS Grid listing photos.
CLOUDINARY_URL=
# Cloudinary cloud name (the three-part form of CLOUDINARY_URL).
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key (the three-part form).
CLOUDINARY_API_KEY=
# Cloudinary API secret (the three-part form).
CLOUDINARY_API_SECRET=

# ---- Build (build/build.py, Netlify build environment) ----
# GA4 measurement id; the Google Analytics tag is added only when set.
GA_MEASUREMENT_ID=
# Meta Pixel id; the pixel is added only when set.
META_PIXEL_ID=
# Google Search Console verification token for the meta tag; unset = no tag.
GSC_VERIFICATION=
# Booking link for the schedule button; unset = the link in build.py's SITE settings.
CALENDLY_URL=

# ---- scripts/netlify-build.sh overrides (testing only; leave unset) ----
# Python to build with; unset = python3.
PYTHON_BIN=
# The generator; unset = build/build.py.
BUILD_SCRIPT=
# The freshness step; unset = build/postprocess_freshness.py.
FRESHNESS_SCRIPT=
# The pip requirements file; unset = requirements.txt.
REQS_FILE=

# ---- Lofty through the Seller Intelligence hub (Wave 1b, lib/_lofty-hub.js; docs/LOFTY-VIA-HUB.md) ----
# Exactly "on" sends form leads and the queue replay to the hub's Lofty doorway (HUB_API_URL + HUB_API_KEY); unset = this site's own LOFTY_API_KEY.
LOFTY_VIA_HUB=
# Exactly "on" also records each form lead with the hub's lead router (never the rent-to-own form); unset = off.
LEADS_TO_ROUTER=

# ---- The side-by-side check with the hub (lib/_hub-side-by-side.js; docs/hub-side-by-side.md) ----
# Comma-separated areas to also ask the hub about and compare, next to this site's own work (lofty_write, mls_read); unset = off.
HUB_SIDE_BY_SIDE=
# Comparisons per run (the scheduled sync and the town-figures job) or per hour (the form handler); unset = 20, at most 200.
HUB_SIDE_BY_SIDE_MAX=

# ---- Shared toolkit Google sign-in (netlify/functions/lib/suite-kit/google-signin.js) ----
# The vendored toolkit (0.5.2) carries the suite-wide Google sign-in. This site has no sign-in and never calls it: leave unset.
GOOGLE_SIGNIN=
# Toolkit Google sign-in only (see above): "on" would allow Google sign-in alone. Not used by this site; leave unset.
GOOGLE_SIGNIN_ONLY=
# Toolkit Google sign-in only: the Google OAuth client id. Not used by this site; leave unset.
GOOGLE_CLIENT_ID=
# Toolkit Google sign-in only: the Google OAuth client secret. Not used by this site; leave unset.
GOOGLE_CLIENT_SECRET=
# Toolkit Google sign-in only: the key that signs a sign-in session. Not used by this site; leave unset.
SESSION_SECRET=
# Toolkit Google sign-in only: the public address Google sends a sign-in back to. Not used by this site; leave unset.
PUBLIC_BASE_URL=
